# Cloudflare Pages response headers for FireSync (https://firesync.space).
# Docs: https://developers.cloudflare.com/pages/configuration/headers/
# Developed with SI (Claude, Anthropic) assistance.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Frame-Options: SAMEORIGIN
  Cross-Origin-Opener-Policy: same-origin

# HTML: always revalidate so a redeploy is visible at once.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# App code: short cache (file names are not hashed).
/js/*
  Cache-Control: public, max-age=0, must-revalidate
/css/*
  Cache-Control: public, max-age=0, must-revalidate

# Harmonized data products: change only when the pipeline is re-run.
/data/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Access-Control-Allow-Origin: *

/assets/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/og.png
  Cache-Control: public, max-age=86400
